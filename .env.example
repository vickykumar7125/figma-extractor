# Copy to .env if you want. The process environment is what the program reads.
# Do not put API keys in a JSON config file.

LLM_ENABLED=false
LLM_PROVIDER=huggingface

# local is the default. remote (or endpoint) calls the Hugging Face Hub.
HF_BACKEND=local
HF_LOCAL_MODEL_PATH=/models/Qwen3-0.6B
HF_TASK=text-generation
HF_DEVICE_MAP=auto
HF_DEVICE=auto
HF_DTYPE=auto

# none, 4bit, or 8bit. 4-bit and 8-bit require NVIDIA CUDA and bitsandbytes.
HF_QUANTIZATION=none
HF_BNB_4BIT_QUANT_TYPE=nf4
HF_BNB_4BIT_COMPUTE_DTYPE=float16
HF_BNB_4BIT_USE_DOUBLE_QUANT=true
# error refuses unsupported hardware. fallback runs full precision and says so.
HF_QUANTIZATION_ON_UNSUPPORTED=error

# true refuses model download and sets the Hub/Transformers offline variables during load.
HF_OFFLINE=false

HF_MAX_NEW_TOKENS=512
HF_TOP_P=1.0
HF_REPETITION_PENALTY=1.0

# Remote backend only. Not used when HF_BACKEND=local.
# HF_TOKEN=
# HUGGINGFACEHUB_API_TOKEN=
